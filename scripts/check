#!/bin/sh
# Type-checks every Luau file against OmniShell's definitions.
# Uses the running OmniWM's copy when present, else the v0.8.0 file cached in .cache/.
# Needs luau-lsp on PATH (Linux: `nix shell nixpkgs#luau-lsp`).
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
defs="$HOME/.config/omniwm/shell/omniwm.d.luau"
if [ ! -f "$defs" ]; then
    defs="$root/.cache/omniwm.d.luau"
    if [ ! -f "$defs" ]; then
        mkdir -p "$root/.cache"
        curl -fsSL -o "$defs" \
            "https://raw.githubusercontent.com/OmniNull/OmniWM/v0.8.0/Sources/OmniWM/Resources/omniwm.d.luau"
    fi
fi

cd "$root"
# OmniShell resolves require("../lib/...") from the shell folder or profile, not relative to the file.
# For init.luau that matches Luau's own rule; for component.luau luau-lsp looks in widgets/lib and
# reports an unknown require, so those lines are dropped.
output=$(find lib widgets -name '*.luau' -exec luau-lsp analyze --no-flags-enabled --platform standard \
    --definitions=@omniwm="$defs" {} + 2>&1) || true
output=$(printf '%s\n' "$output" | grep -v 'component\.luau([0-9,]*): TypeError: Unknown require: .*/widgets/lib/' || true)
printf '%s\n' "$output"
if printf '%s\n' "$output" | grep -q 'Error'; then
    exit 1
fi
